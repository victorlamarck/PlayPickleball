rules_version = '2';

// Read model for live scores. Only the backend writes (Admin SDK / service account, which
// bypasses these rules). Clients can only read.
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read: spectators may be signed out. In production this could require
    // Firebase Auth (request.auth != null) or App Check.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if false;

      match /matches/{matchId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
